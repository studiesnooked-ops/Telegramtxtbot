# ─────────────────────────────────────────────
#  Telegram Video Extractor Bot — Environment
# ─────────────────────────────────────────────

# REQUIRED: Your BotFather token
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# REQUIRED for Render (set to your Render service URL, e.g. https://my-bot.onrender.com)
RENDER_EXTERNAL_URL=https://your-service.onrender.com

# Webhook mode (true = webhook for Render, false = long-polling for local dev)
USE_WEBHOOK=true

# Secret path token — change this to something random
WEBHOOK_SECRET=change_me_to_a_random_string

# Port Render assigns (leave as 8080 — Render injects PORT automatically)
PORT=8080

# Max upload size in MB
MAX_FILE_SIZE_MB=20

# Max URLs extracted per file
MAX_URLS_PER_FILE=500

# Delay between sending batches of messages (seconds)
BATCH_SEND_DELAY=0.5

# Parallel worker processes for extraction
MAX_WORKERS=4

# Comma-separated Telegram user IDs with admin access (leave blank = all users are admins)
ADMIN_IDS=

# Directory paths (relative to project root)
UPLOAD_DIR=uploads
DOWNLOAD_DIR=downloads
LOG_DIR=logs
